---
import Base from "../layouts/Base.astro";
import Timeline from "./Timeline.astro";
import Footer from "./Footer.astro";
import {
  parsePulseLog,
  getArchiveMonths,
  getArchiveWeeks,
  getCategories,
  weekDayRange,
} from "../lib/parse-pulse.js";
import { getStrings, getAllLanguageOptions } from "../lib/i18n.js";

interface Props {
  locale: string;
  month: string;
  week: string;
}

const { locale, month, week } = Astro.props;
const t = getStrings(locale);
const languageOptions = getAllLanguageOptions();
const categories = getCategories();

const allItems = parsePulseLog();
const items = allItems.filter(
  (item) => item.month === month && item.week === week,
);
const months = getArchiveMonths(allItems);
const weeks = getArchiveWeeks(month, allItems);
const weekIndex = weeks.indexOf(week);
// weeks is newest-first: "previous" week in time sits at a higher index.
const prevWeek = weekIndex < weeks.length - 1 ? weeks[weekIndex + 1] : null;
const nextWeek = weekIndex > 0 ? weeks[weekIndex - 1] : null;

const monthIndex = months.indexOf(month);
const prevMonth = monthIndex < months.length - 1 ? months[monthIndex + 1] : null;
const nextMonth = monthIndex > 0 ? months[monthIndex - 1] : null;

const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith("/") ? base : `${base}/`;
const archivePath = `archive/${month}/${week}/`;
const monthPath = `archive/${month}/`;

function localeUrl(loc: string, path: string = archivePath): string {
  const prefix = loc === "en" ? "" : `${loc}/`;
  return `${normalizedBase}${prefix}${path}`;
}
const homeUrl = localeUrl(locale, "");
const monthUrl = localeUrl(locale, monthPath);

const weekNum = week.replace(/^w/i, "");
const days = items.map((item) => Number(item.displayDate.slice(8, 10)));
const { start: fallbackStart, end: fallbackEnd } = weekDayRange(week);
const startDay = days.length ? Math.min(...days) : fallbackStart;
const endDay = days.length ? Math.max(...days) : fallbackEnd;

const title = t.archiveWeekTitle
  .replace("{month}", month)
  .replace("{n}", weekNum);
const description = t.archiveWeekDescription
  .replace("{month}", month)
  .replace("{n}", weekNum)
  .replace("{start}", String(startDay))
  .replace("{end}", String(endDay));

const JSON_LD_ITEM_LIMIT = 20;
const jsonLdItems = items.slice(0, JSON_LD_ITEM_LIMIT);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: title,
  numberOfItems: jsonLdItems.length,
  itemListElement: jsonLdItems.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "NewsArticle",
      headline: (item.summaries?.[locale] || item.summary).slice(0, 110),
      datePublished: item.datetimeUtc,
      url: item.url,
      inLanguage: t.htmlLang,
    },
  })),
};
---

<Base
  title={title}
  description={description}
  htmlLang={t.htmlLang}
  locale={locale}
  path={archivePath}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <header class="header">
    <div class="header-inner">
      <p class="site-name"><a href={homeUrl}>{t.title}</a></p>
      <h1>
        {t.archiveLabel} — {month}
        <span class="week-heading">
          {t.weekLabel.replace("{n}", weekNum)}
        </span>
      </h1>
      <p class="week-sub">
        {
          t.weekRange
            .replace("{start}", String(startDay))
            .replace("{end}", String(endDay))
        }
        · {t.itemsCount.replace("{n}", String(items.length))}
      </p>
      <nav class="lang-nav" aria-label={t.languageLabel}>
        {
          languageOptions.map((opt) =>
            opt.key === locale ? (
              <span class="lang-pill lang-active">{opt.name}</span>
            ) : (
              <a class="lang-pill" href={localeUrl(opt.key)}>
                {opt.name}
              </a>
            ),
          )
        }
      </nav>
    </div>
    <div class="header-line"></div>
  </header>

  <main class="main">
    <nav class="month-nav" aria-label={t.browseArchive}>
      {
        prevWeek ? (
          <a
            class="month-link"
            href={localeUrl(locale, `archive/${month}/${prevWeek}/`)}
          >
            ← {t.weekLabel.replace("{n}", prevWeek.replace(/^w/i, ""))}
          </a>
        ) : prevMonth ? (
          <a class="month-link" href={localeUrl(locale, `archive/${prevMonth}/`)}>
            ← {prevMonth}
          </a>
        ) : (
          <span />
        )
      }
      <a class="month-link month-home" href={monthUrl}>
        {month}
      </a>
      {
        nextWeek ? (
          <a
            class="month-link"
            href={localeUrl(locale, `archive/${month}/${nextWeek}/`)}
          >
            {t.weekLabel.replace("{n}", nextWeek.replace(/^w/i, ""))} →
          </a>
        ) : nextMonth ? (
          <a class="month-link" href={localeUrl(locale, `archive/${nextMonth}/`)}>
            {nextMonth} →
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    <nav class="filters" id="filters" aria-label={t.filterCategory}>
      <div class="filter-group">
        <span class="filter-label">{t.filterCategory}</span>
        <button class="filter-btn active" data-category="all" aria-pressed="true">
          {t.filterAll}
        </button>
        {
          categories.map((cat) => (
            <button
              class="filter-btn"
              data-category={cat.key}
              style={`--cat-color: ${cat.color}`}
              aria-pressed="false"
            >
              <span class="cat-dot" style={`background: ${cat.color}`} />
              {t.categories[cat.key] || cat.label}
            </button>
          ))
        }
      </div>
      <div class="filter-group">
        <span class="filter-label">{t.filterSearch}</span>
        <input
          id="archive-search"
          class="search-input"
          type="search"
          placeholder={t.searchPlaceholder}
          aria-label={t.filterSearch}
        />
      </div>
    </nav>

    <Timeline items={items} locale={locale} t={t} />

    <p class="empty-state" id="empty" style="display: none;">
      {t.empty}
    </p>

    <nav class="week-jump" aria-label={t.browseWeeks}>
      <span class="week-jump-label">{t.browseWeeks}</span>
      {
        weeks.map((w) => {
          const n = w.replace(/^w/i, "");
          const href = localeUrl(locale, `archive/${month}/${w}/`);
          return w === week ? (
            <span class="week-pill week-pill-active">
              {t.weekLabel.replace("{n}", n)}
            </span>
          ) : (
            <a class="week-pill" href={href}>
              {t.weekLabel.replace("{n}", n)}
            </a>
          );
        })
      }
    </nav>

    <Footer t={t} />
  </main>
</Base>

<script>
  import { initArchiveSearch } from "../scripts/archive-client.js";
  initArchiveSearch();
</script>

<style>
  .header {
    padding: 3rem 1rem 0;
  }

  .header-inner {
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
  }

  .site-name {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.375rem;
  }

  .site-name a {
    color: inherit;
  }

  .site-name a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .header h1 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .week-heading {
    display: block;
    margin-top: 0.25rem;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .week-sub {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .lang-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .lang-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  a.lang-pill:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .lang-active {
    color: var(--accent);
    border-color: var(--accent);
    font-weight: 600;
  }

  .header-line {
    max-width: 48rem;
    margin: 2rem auto 0;
    height: 1px;
    background: var(--border);
    position: relative;
  }

  .header-line::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 3rem;
    height: 1px;
    background: var(--accent);
  }

  .main {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1rem 3rem;
  }

  .month-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .month-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .month-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .week-jump {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .week-jump-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-right: 0.75rem;
  }

  .week-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  a.week-pill:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .week-pill-active {
    color: var(--accent);
    border-color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .header {
      padding-top: 2rem;
    }

    .header h1 {
      font-size: 1.375rem;
    }
  }
</style>
