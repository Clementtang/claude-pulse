---
import Base from "../layouts/Base.astro";
import Timeline from "./Timeline.astro";
import Footer from "./Footer.astro";
import {
  parsePulseLog,
  getCategories,
  getArchiveMonths,
  toDisplayDate,
} from "../lib/parse-pulse.js";
import {
  getStrings,
  getAllLanguageOptions,
  SUPPORTED_LOCALES,
} from "../lib/i18n.js";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getStrings(locale);
const languageOptions = getAllLanguageOptions();

const allItems = parsePulseLog(); // already sorted desc by datetimeUtc
// Home window is short; older entries live on monthly archive pages.
// July 2026 alone hit ~9 items/day — a 30-day home DOM was ~500 KB HTML.
const HOME_WINDOW_DAYS = 14;
const JSON_LD_ITEM_LIMIT = 20;
const cutoff = toDisplayDate(
  new Date(Date.now() - HOME_WINDOW_DAYS * 24 * 60 * 60 * 1000).toISOString(),
);
const items = allItems.filter((item) => item.displayDate >= cutoff);
const months = getArchiveMonths(allItems);
const categories = getCategories();

const base = import.meta.env.BASE_URL;

// Build language URLs — each locale points to its own index page
const normalizedBase = base.endsWith("/") ? base : `${base}/`;
function localeUrl(loc: string): string {
  return loc === "en" ? normalizedBase : `${normalizedBase}${loc}/`;
}

function archiveUrl(month: string): string {
  return `${localeUrl(locale)}archive/${month}/`;
}

// Cap structured data: full month-scale lists bloat HTML without helping
// readers (SEO track is closed; a short ItemList is enough for machines).
const jsonLdItems = items.slice(0, JSON_LD_ITEM_LIMIT);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: t.seoTitle || t.title,
  numberOfItems: jsonLdItems.length,
  itemListElement: jsonLdItems.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "NewsArticle",
      headline: (item.summaries?.[locale] || item.summary).slice(0, 110),
      datePublished: item.datetimeUtc,
      url: item.url,
      inLanguage: t.htmlLang,
    },
  })),
};
---

<Base
  title={t.seoTitle || t.title}
  description={t.metaDescription}
  htmlLang={t.htmlLang}
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <header class="header">
    <div class="header-inner">
      <h1>
        <svg class="logo" width="36" height="20" viewBox="0 0 36 20" fill="none" aria-hidden="true">
          <polyline
            points="0,10 6,10 9,10 12,3 15,17 18,6 21,14 24,10 28,10 36,10"
            stroke="var(--accent)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"
          />
        </svg>
        {t.title}
      </h1>
      <p class="subtitle">{t.subtitle}</p>
      <nav class="lang-nav" aria-label={t.languageLabel}>
        {
          languageOptions.map((opt) =>
            opt.key === locale ? (
              <span class="lang-pill lang-active">{opt.name}</span>
            ) : (
              <a class="lang-pill" href={localeUrl(opt.key)}>
                {opt.name}
              </a>
            ),
          )
        }
      </nav>
      <div class="header-meta">
        <a
          id="status-link"
          class="status-link"
          href="https://status.claude.com"
          target="_blank"
          rel="noopener noreferrer"
          title="Claude Service Status"
        >
          <span class="status-dot" data-indicator="loading"></span>
          <span class="status-text">{t.statusLoading}</span>
          <span class="external-icon" aria-hidden="true">&#8599;</span>
        </a>
        <a href={`${base}feed.xml`} class="rss-link" title="RSS Feed">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="6.18" cy="17.82" r="2.18"></circle>
            <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"
            ></path>
          </svg>
          {t.rss}
        </a>
      </div>
    </div>
    <div class="header-line"></div>
  </header>

  <main class="main">
    <nav class="filters" id="filters">
      <div class="filter-group">
        <span class="filter-label">{t.filterCategory}</span>
        <button class="filter-btn active" data-category="all">
          {t.filterAll}
        </button>
        {
          categories.map((cat) => (
            <button
              class="filter-btn"
              data-category={cat.key}
              style={`--cat-color: ${cat.color}`}
            >
              <span class="cat-dot" style={`background: ${cat.color}`} />
              {t.categories[cat.key] || cat.label}
            </button>
          ))
        }
      </div>
      <div class="filter-group">
        <span class="filter-label">{t.filterTime}</span>
        <button class="filter-btn range-btn active" data-range="7">
          {t.range7}
        </button>
        <button class="filter-btn range-btn" data-range="14">
          {t.range14}
        </button>
        <a class="filter-btn archive-link" href={archiveUrl(months[0])}>
          {t.archiveLabel} ↗
        </a>
      </div>
      <div class="filter-group">
        <span class="filter-label">{t.filterSearch}</span>
        <input
          id="search-input"
          class="search-input"
          type="search"
          placeholder={t.searchPlaceholder}
          aria-label={t.filterSearch}
        />
      </div>
    </nav>

    <Timeline items={items} locale={locale} t={t} />

    <p class="empty-state" id="empty" style="display: none;">
      {t.empty}
    </p>

    <nav class="archive-nav" aria-label={t.browseArchive}>
      <span class="archive-nav-label">{t.browseArchive}</span>
      {
        months.map((month) => (
          <a class="archive-month" href={archiveUrl(month)}>
            {month}
          </a>
        ))
      }
    </nav>

    <Footer t={t} />
  </main>
</Base>

<script
  type="application/json"
  id="pulse-home-config"
  set:html={JSON.stringify({
    currentLocale: locale,
    supportedLocales: SUPPORTED_LOCALES,
    relativeStrings: t.relative,
    statusOkDefault: t.statusOk,
    weekdayFormat: t.weekdayFormat,
    basePath: normalizedBase,
  })}
/>
<script>
  import { initHomePage } from "../scripts/home-client.js";

  const el = document.getElementById("pulse-home-config");
  if (el) {
    initHomePage(JSON.parse(el.textContent || "{}"));
  }
</script>

<style>
  /* ============================================================
     HEADER — Editorial masthead
     ============================================================ */
  .header {
    padding: 3rem 1rem 0;
  }

  .header-inner {
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
  }

  .header h1 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .subtitle {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: 0.375rem;
  }

  .header-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .rss-link,
  .status-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .rss-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  /* ============================================================
     STATUS INDICATOR
     ============================================================ */
  .status-link {
    max-width: 18rem;
    overflow: hidden;
  }

  .status-link .status-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .status-link:hover {
    border-color: var(--border-hover);
    color: var(--text-secondary);
    text-decoration: none;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-tertiary);
    flex-shrink: 0;
    position: relative;
  }

  .status-dot[data-indicator="none"] {
    background: #10b981;
  }
  .status-dot[data-indicator="minor"] {
    background: #f59e0b;
  }
  .status-dot[data-indicator="major"],
  .status-dot[data-indicator="critical"] {
    background: #dc2626;
  }
  .status-dot[data-indicator="maintenance"] {
    background: #2563eb;
  }

  .status-dot[data-indicator="minor"]::before,
  .status-dot[data-indicator="major"]::before,
  .status-dot[data-indicator="critical"]::before {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 1px solid currentColor;
    color: inherit;
    animation: status-pulse 2s ease-out infinite;
  }

  @keyframes status-pulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .status-link.ready .status-text {
    color: inherit;
  }

  .external-icon {
    font-size: 0.75rem;
    line-height: 1;
    opacity: 0.7;
  }

  /* ============================================================
     LOGO
     ============================================================ */
  .logo {
    vertical-align: middle;
    margin-right: 0.375rem;
    position: relative;
    top: -1px;
  }

  /* ============================================================
     LANGUAGE NAV — pill buttons matching status/RSS style
     ============================================================ */
  .lang-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .lang-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  a.lang-pill:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .lang-active {
    color: var(--accent);
    border-color: var(--accent);
    font-weight: 600;
  }

  .header-line {
    max-width: 48rem;
    margin: 2.5rem auto 0;
    height: 1px;
    background: var(--border);
    position: relative;
  }

  .header-line::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 3rem;
    height: 1px;
    background: var(--accent);
  }

  /* ============================================================
     MAIN / FILTERS
     ============================================================ */
  .main {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2.5rem 1rem 3rem;
  }

  /* ============================================================
     ARCHIVE NAV
     ============================================================ */
  .archive-link {
    text-decoration: none;
  }

  .archive-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .archive-nav-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-right: 0.75rem;
  }

  .archive-month {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .archive-month:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 640px) {
    .header {
      padding-top: 2rem;
    }

    .header h1 {
      font-size: 1.625rem;
    }

    .subtitle {
      font-size: 0.8125rem;
    }

    .header-line {
      margin-top: 1.75rem;
    }

    .main {
      padding: 2rem 1rem 2rem;
    }
  }
</style>
