---
import { SUPPORTED_LOCALES } from "../lib/i18n.js";

interface Props {
  title?: string;
  description?: string;
  htmlLang?: string;
  locale?: string;
  /** Page path relative to the locale root, no leading slash, trailing slash kept.
      "" = locale home; e.g. "models/" for a future /models/ page. */
  path?: string;
}

const {
  title = "Claude Pulse",
  description = "Anthropic / Claude news tracker",
  htmlLang = "en",
  locale = "en",
  path = "",
} = Astro.props;

const base = import.meta.env.BASE_URL;

// Absolute canonical + hreflang URLs. en is the default locale (no path prefix);
// other locales live under /{locale}/. trailingSlash: "always" keeps the slash.
const SITE = (Astro.site?.href ?? "https://claude-pulse.chatbot.tw/").replace(
  /\/$/,
  "",
);
function localeUrl(loc: string, p: string = path): string {
  const prefix = loc === "en" ? "" : `${loc}/`;
  return `${SITE}/${prefix}${p}`;
}
const canonicalUrl = localeUrl(locale);
const alternates = SUPPORTED_LOCALES.map((loc) => ({
  hreflang: loc,
  href: localeUrl(loc),
}));

// Load only the CJK face this page needs. Latin faces are shared; shipping
// all four Noto families on every locale wasted three font round-trips.
const CJK_FONT_FAMILY: Record<string, string> = {
  "zh-TW": "Noto+Sans+TC",
  "zh-CN": "Noto+Sans+SC",
  ja: "Noto+Sans+JP",
  ko: "Noto+Sans+KR",
};
const latinFonts =
  "family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Source+Sans+3:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500";
const cjkFamily = CJK_FONT_FAMILY[locale];
const fontsHref = `https://fonts.googleapis.com/css2?${latinFonts}${
  cjkFamily ? `&family=${cjkFamily}:wght@400;500` : ""
}&display=swap`;
---

<!doctype html>
<html lang={htmlLang} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#faf9f0"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#141413"
    />
    <meta name="description" content={description} />
    <!-- Bing Webmaster Tools ownership verification (same ID as BingSiteAuth.xml) -->
    <meta name="msvalidate.01" content="D23785EF988DB5D7F8C38A7C6DFFAE46" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsHref} rel="stylesheet" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Claude Pulse RSS"
      href={`${base}feed.xml`}
    />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={localeUrl("en")} />
    <title>{title}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-R69N8EZQE7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-R69N8EZQE7');
    </script>
    <style is:global>
      :root {
        /* Backgrounds — warm cream */
        --bg: #faf9f0;
        --bg-surface: #f5f3e8;
        --bg-surface-hover: #efede0;

        /* Text hierarchy — deep warm neutrals */
        --text: #1a1a1b;
        --text-secondary: #5c5a52;
        --text-tertiary: #9c9889;

        /* Accent — Anthropic terracotta */
        --accent: #d97757;
        --accent-light: #e8956f;

        /* Borders — warm gray */
        --border: #e5e2d6;
        --border-hover: #d4d0c2;

        /* Category colors — centralized so dark mode can swap them */
        --cat-claude-code: #2563eb;
        --cat-platform: #059669;
        --cat-research: #7c3aed;
        --cat-industry: #d97706;
        --cat-enterprise: #dc2626;

        /* Font stacks — English base; CJK falls back to system (en loads no Noto) */
        --font-display: "Newsreader", Georgia, serif;
        --font-body: "Source Sans 3", system-ui, sans-serif;
        --font-mono: "IBM Plex Mono", ui-monospace, monospace;

        /* Spacing tokens */
        --sp-1: 0.5rem;
        --sp-2: 1rem;
        --sp-3: 1.5rem;
        --sp-4: 2rem;
        --sp-6: 3rem;
        --sp-8: 4rem;
      }

      /* Dark theme — follows the system, warm blacks to keep the paper
         feel. Category colors brighten one step for contrast on dark. */
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #141413;
          --bg-surface: #1e1d1b;
          --bg-surface-hover: #262420;

          --text: #f0efe6;
          --text-secondary: #b8b5a8;
          --text-tertiary: #7d7a6e;

          --accent: #e8956f;
          --accent-light: #f0ab89;

          --border: #2e2c27;
          --border-hover: #3a3831;

          --cat-claude-code: #7aa5f8;
          --cat-platform: #34d399;
          --cat-research: #a78bfa;
          --cat-industry: #fbbf24;
          --cat-enterprise: #f87171;
        }
      }

      /* Per-locale CJK primary font */
      html[data-locale="zh-TW"] {
        --font-body: "Noto Sans TC", "Source Sans 3", system-ui, sans-serif;
        --font-display: "Newsreader", "Noto Sans TC", Georgia, serif;
      }
      html[data-locale="zh-CN"] {
        --font-body: "Noto Sans SC", "Source Sans 3", system-ui, sans-serif;
        --font-display: "Newsreader", "Noto Sans SC", Georgia, serif;
      }
      html[data-locale="ja"] {
        --font-body: "Noto Sans JP", "Source Sans 3", system-ui, sans-serif;
        --font-display: "Newsreader", "Noto Sans JP", Georgia, serif;
      }
      html[data-locale="ko"] {
        --font-body: "Noto Sans KR", "Source Sans 3", system-ui, sans-serif;
        --font-display: "Newsreader", "Noto Sans KR", Georgia, serif;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-body);
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        transition: color 0.15s;
      }

      a:hover {
        color: var(--accent-light);
        text-decoration: underline;
      }

      /* Shared by HomePage + ArchivePage filter chrome */
      .search-input {
        font-family: var(--font-body);
        font-size: 0.8125rem;
        color: var(--text);
        background: transparent;
        border: 1px solid var(--border);
        border-radius: 0.25rem;
        padding: 0.25rem 0.625rem;
        width: 14rem;
        max-width: 100%;
        transition: border-color 0.15s;
      }

      .search-input::placeholder {
        color: var(--text-tertiary);
      }

      .search-input:focus {
        outline: none;
        border-color: var(--accent);
      }

      .filters {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border);
      }

      .filter-group {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.375rem;
      }

      .filter-label {
        font-family: var(--font-body);
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-right: 0.75rem;
      }

      .filter-btn {
        background: none;
        border: none;
        color: var(--text-secondary);
        font-family: var(--font-body);
        font-size: 0.8125rem;
        font-weight: 500;
        padding: 0.25rem 0.25rem;
        border-bottom: 2px solid transparent;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        transition:
          color 0.15s,
          border-color 0.15s;
      }

      .filter-btn:hover {
        color: var(--text);
      }

      .filter-btn.active {
        color: var(--accent);
        border-bottom-color: var(--accent);
      }

      .filter-btn:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
        border-radius: 2px;
      }

      .filter-btn .cat-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
      }

      .empty-state {
        text-align: center;
        color: var(--text-tertiary);
        padding: 3rem 0;
        font-family: var(--font-body);
      }

      @media (max-width: 640px) {
        .filter-label {
          width: 100%;
          margin-bottom: 0.25rem;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
