---
import ArchivePage from "../../../../../components/ArchivePage.astro";
import { getArchiveMonthWeekPaths } from "../../../../../lib/parse-pulse.js";

export function getStaticPaths() {
  return getArchiveMonthWeekPaths().map(({ month, week }) => ({
    params: { month, week },
  }));
}

const { month, week } = Astro.params;
---

<ArchivePage locale="ja" month={month} week={week} />
