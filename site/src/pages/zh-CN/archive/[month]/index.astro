---
import ArchiveMonthHub from "../../../../components/ArchiveMonthHub.astro";
import { getArchiveMonths } from "../../../../lib/parse-pulse.js";

export function getStaticPaths() {
  return getArchiveMonths().map((month) => ({ params: { month } }));
}

const { month } = Astro.params;
---

<ArchiveMonthHub locale="zh-CN" month={month} />
